# Copy to .env on your VPS; never commit .env or credentials.
PORT=8080
ALLOWED_ORIGIN=https://insaneprinceyt.github.io
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
DOCKER_SOCKET=/var/run/docker.sock
MAX_RAM_MB=8192
MAX_SERVERS_PER_USER=2
MC_PORT_START=25565
MC_PORT_END=25665
MC_IMAGE=itzg/minecraft-server:java21
DATA_DIR=/var/lib/prince-cloud/servers
BACKUP_DIR=/var/lib/prince-cloud/backups
# Billing is disabled unless configured. Do not enable without verified webhooks.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ELITE=
# BILLING_SUCCESS_URL=
# BILLING_CANCEL_URL=
